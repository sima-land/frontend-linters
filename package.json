{
  "name": "@sima-land/linters",
  "type": "module",
  "version": "0.0.0",
  "repository": {
    "url": "git+ssh://git@github.com/sima-land/frontend-linters.git"
  },
  "author": "www.sima-land.ru team",
  "license": "Apache-2.0",
  "description": "Code style linter configuration presets",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint",
    "prettier:write": "prettier . --write --ignore-unknown",
    "prettier:check": "prettier . --check --ignore-unknown",
    "type:check": "tsc --noEmit",
    "build": "rm -rf build && tsc"
  },
  "dependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/js": "^9.30.1",
    "@stylistic/eslint-plugin": "^5.1.0",
    "confusing-browser-globals": "^1.0.11",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsdoc": "^51.3.4",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "stylelint-config-sass-guidelines": "^12.1.0",
    "stylelint-scss": "^6.12.1",
    "typescript-eslint": "^8.35.1"
  },
  "peerDependencies": {
    "eslint": "^9.30.1",
    "stylelint": "^16.21.1"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/confusing-browser-globals": "^1.0.3",
    "eslint": "^9.30.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "exports": {
    "./eslint": "./dist/eslint/index.js",
    "./eslint/base": "./dist/eslint/base.js",
    "./eslint/jest": "./dist/eslint/jest.js",
    "./eslint/jsdoc-jest": "./dist/eslint/jsdoc-jest.js",
    "./eslint/jsdoc-ts": "./dist/eslint/jsdoc-ts.js",
    "./eslint/jsdoc": "./dist/eslint/jsdoc.js",
    "./eslint/lodash": "./dist/eslint/lodash.js",
    "./eslint/react": "./dist/eslint/react.js",
    "./eslint/typescript": "./dist/eslint/typescript.js",
    "./stylelint": "./dist/stylelint/index.js",
    "./prettier": "./dist/prettier/index.js"
  }
}
